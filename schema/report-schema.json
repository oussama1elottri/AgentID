{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProofAgentEvaluationReport",
  "description": "Standardized evaluation report schema for ProofAgent AI Agent verification",
  "type": "object",
  "properties": {
    "agentId": {
      "type": "string",
      "description": "Unique identifier of the AI agent being evaluated"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of evaluation completion"
    },
    "evaluator": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" }
      },
      "required": ["name", "address"]
    },
    "performanceMetrics": {
      "type": "object",
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "latencyMs": { "type": "number" },
        "successRate": { "type": "number" }
      },
      "required": ["score"]
    },
    "verdict": {
      "type": "string",
      "enum": ["PASSED", "FAILED", "NEEDS_REVIEW"]
    },
    "proofHash": {
      "type": "string",
      "description": "Cryptographic SHA256 hash of the execution trace"
    }
  },
  "required": ["agentId", "timestamp", "evaluator", "performanceMetrics", "verdict", "proofHash"]
}
